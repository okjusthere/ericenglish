{
  "name": "eric-english-os",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.4.1",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit && wrangler types --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:migrate:local": "wrangler d1 migrations apply eric-english-os-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply eric-english-os-db --remote",
    "db:seed:local": "tsx scripts/seed-d1.ts --local",
    "db:seed:remote": "tsx scripts/seed-d1.ts --remote",
    "seed:generate": "tsx scripts/generate-seed.ts",
    "cf:bootstrap": "node scripts/bootstrap-cloudflare.mjs",
    "smoke:local": "tsx scripts/smoke.ts http://127.0.0.1:5173",
    "smoke:production": "tsx scripts/smoke.ts",
    "ai:health": "tsx scripts/provider-health.ts",
    "cf:types": "wrangler types"
  },
  "dependencies": {
    "@hono/zod-validator": "0.9.0",
    "hono": "4.13.5",
    "idb": "8.0.3",
    "lucide-react": "1.37.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.3",
    "recharts": "3.10.1",
    "ts-fsrs": "5.4.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.2",
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.5",
    "globals": "17.11.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "wrangler": "4.127.1"
  }
}
