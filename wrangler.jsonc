{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "eric-english-os",
  "main": "src/worker/index.ts",
  "routes": [
    { "pattern": "english.diypokecard.com", "custom_domain": true }
  ],
  "compatibility_date": "2026-08-30",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/health"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "eric-english-os-db",
      "database_id": "497886ba-97e0-41da-b9c8-ca63bf474f6b",
      "migrations_dir": "./migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "AUDIO_BUCKET", "bucket_name": "eric-english-os-audio" }
  ],
  "ai": { "binding": "AI" },
  "workflows": [
    { "binding": "SESSION_ANALYSIS", "name": "session-analysis", "class_name": "SessionAnalysisWorkflow" },
    { "binding": "WEEKLY_REPORT", "name": "weekly-report", "class_name": "WeeklyReportWorkflow" },
    { "binding": "CURRICULUM_BOOTSTRAP", "name": "curriculum-bootstrap", "class_name": "CurriculumBootstrapWorkflow" }
  ],
  "triggers": { "crons": ["0 * * * *"] },
  "vars": {
    "APP_ENV": "production",
    "APP_TIMEZONE": "America/New_York",
    "SINGLE_USER_ID": "primary",
    "OWNER_EMAIL": "eric.wei@kevv.ai",
    "AUDIO_RETENTION_DAYS": "30",
    "DEFAULT_DAILY_MINUTES": "60",
    "AI_PROVIDER_MODE": "workers_ai",
    "AI_GATEWAY_ACCOUNT_ID": "3dece8c6e6159891f5934007a97d81d3",
    "AI_GATEWAY_ID": "eric-english-os-ai",
    "AI_GATEWAY_API_BASE": "",
    "AI_GATEWAY_BYOK_ALIAS": "",
    "DIRECT_LLM_API_BASE": "https://api.openai.com/v1",
    "AI_MODEL_FAST": "@cf/qwen/qwen3-30b-a3b-fp8",
    "AI_MODEL_STRONG": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "AI_MODEL_CONTENT": "@cf/qwen/qwen3-30b-a3b-fp8",
    "AI_MODEL_STT": "@cf/openai/whisper-large-v3-turbo",
    "AI_MODEL_TTS": "",
    "MONTHLY_AI_BUDGET_USD": "25",
    "SPEECH_MODE": "azure_tts",
    "REALTIME_SPEAK_ENABLED": "true",
    "PRONUNCIATION_ASSESSMENT_ENABLED": "false",
    "AZURE_OPENAI_ENDPOINT": "https://kevvrealtime-resource.cognitiveservices.azure.com",
    "AZURE_OPENAI_API_VERSION": "2025-03-01-preview",
    "AZURE_REALTIME_DEPLOYMENT": "gpt-realtime-2.1",
    "AZURE_TTS_DEPLOYMENT": "gpt-4o-mini-tts",
    "AZURE_TRANSCRIBE_DEPLOYMENT": "gpt-4o-mini-transcribe",
    "AZURE_TEXT_DEPLOYMENT": "gpt-5.6-terra",
    "AZURE_TTS_VOICE": "alloy",
    "AZURE_SPEECH_ENDPOINT": "",
    "AZURE_SPEECH_VOICE": "en-US-AvaMultilingualNeural"
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.2 }
  }
}
